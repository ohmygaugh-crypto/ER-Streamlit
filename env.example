# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# DuckDB Configuration (if using external DuckDB instance)
DUCKDB_PATH=./splink.db

# Alternative: PostgreSQL connection for DuckDB-like operations
POSTGRES_URI=postgresql://splink:splink_password@localhost:5432/splink

# Jupyter Configuration
JUPYTER_TOKEN=
JUPYTER_PASSWORD=

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501

# Logging Level
LOG_LEVEL=INFO
